# Database credentials for development
# Copy this to .env and fill in your actual credentials
DB_PASSWORD=your_secure_password_here
SERVERPOD_SERVICE_SECRET=your_service_secret_here

# S3 Storage Configuration
# Bucket name where media files are stored (default: chatwit-storage)
S3_BUCKET=your_s3_bucket_name

# AWS region for S3 bucket (default: eu-north-1)
S3_REGION=your_aws_region

# Optional: Custom public domain for S3 (e.g., CDN)
# If not set, defaults to: {S3_BUCKET}.s3.{S3_REGION}.amazonaws.com
# S3_PUBLIC_DOMAIN=cdn.example.com
